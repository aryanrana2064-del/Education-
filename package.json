  "repository": {
    "type": "git",
    "url": "https://github.com/username/secure-website"
  },
  "bugs": {
    "url": "https://github.com/username/secure-website/issues",
    "email": "support@securesite.com"
  },
  "keywords": [
    "security",
    "website",
    "firewall",
    "ddos-protection",
    "ssl",
    "encryption",
    "xss-prevention",
    "sql-injection",
    "csrf-protection",
    "rate-limiting",
    "audit-logging",
    "security-dashboard",
    "admin-panel",
    "user-dashboard",
    "secure-login",
    "authentication",
    "authorization",
    "monitoring",
    "vercel",
    "static-site"
  ],
  "scripts": {
    "start": "echo 'Static site ready — No build needed'",
    "build": "echo 'No build step required for static HTML/CSS/JS'",
    "dev": "npx serve .",
    "test": "echo 'Running security checks...' && node security/security-core.js",
    "lint": "echo 'No linter configured yet'",
    "deploy": "vercel --prod",
    "deploy-preview": "vercel",
    "security-check": "node security/security-core.js",
    "audit": "node security/logger.js",
    "clean": "rm -rf node_modules .vercel"
  },
  "dependencies": {},
  "devDependencies": {
    "serve": "^14.2.0",
    "vercel": "^32.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "files": [
    "index.html",
    "dashboard.html",
    "admin.html",
    "security-dashboard.html",
    "login.html",
    "404.html",
    "500.html",
    "css/",
    "js/",
    "security/",
    "api/",
    "middleware/",
    "config/",
    "assets/",
    "docs/",
    "vercel.json",
    "robots.txt",
    "sitemap.xml",
    ".htaccess"
  ]
